# ===== MyRoom View 環境変数 =====
# このファイルを .env にコピーして値を設定してください。

# サーバーの待ち受けポート
PORT=3000
# 待ち受けアドレス（LAN内の別端末からアクセスするなら 0.0.0.0）
HOST=0.0.0.0

# ----- Nature Remo (室温・エアコン) -----
# https://home.nature.global/ で発行したアクセストークン
NATURE_REMO_TOKEN=

# ----- 天気 (気象庁・無料/トークン不要) -----
# 地域コード。千葉県=120000 / 東京都=130000 / 大阪府=270000 など
JMA_AREA_CODE=120000
# 地震・市区町村の対象（表示判定に使用）。カンマ区切り
QUAKE_WATCH_CITIES=市原市,千葉市
# 地震を表示する最小震度（3 / 4 / 5-弱 など）
QUAKE_MIN_INTENSITY=3

# ----- Zabbix (ノードのCPU/メモリ/ディスク・死活) -----
# 例: http://192.168.1.10/zabbix
ZABBIX_URL=
# Zabbix で発行した API トークン
ZABBIX_TOKEN=

# ----- 自動アップデート (GitHub Releases) -----
GITHUB_REPO=gororin-06/MyRoom_View
AUTO_UPDATE=true
